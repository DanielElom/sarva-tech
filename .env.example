# Sarva Tech — every environment variable the application reads.
#
# Copy to .env.local for local overrides. .env.local is gitignored and must stay
# that way; nothing secret belongs in this file.
#
# Nothing here is REQUIRED. Every variable has a defined fallback, and the build
# fails loudly rather than silently producing a wrong value. `pnpm verify`
# builds with this file's variables absent AND present-but-empty, so a missing
# variable fails locally instead of on Vercel.


# ---------------------------------------------------------------------------
# Canonical site URL
# ---------------------------------------------------------------------------
# Used for metadataBase, Open Graph URLs and canonical links.
# Resolved by resolveSiteUrl() in lib/site.ts, in this order:
#
#   1. NEXT_PUBLIC_SITE_URL            explicit override, wins over everything
#   2. VERCEL_PROJECT_PRODUCTION_URL   set by Vercel, production domain, no scheme
#   3. VERCEL_URL                      set by Vercel, this deployment, no scheme
#   4. http://localhost:3000           built-in default
#
# Values without a scheme get https:// prepended. Empty and whitespace-only
# values fall through to the next candidate rather than being used — an unset
# NEXT_PUBLIC_* variable is inlined by Next as an empty string, not undefined.
# A value that is set but unparseable throws SiteUrlError during the build.
#
# The two VERCEL_ variables are provided automatically by Vercel and are
# server-only, so next.config.ts resolves this once at build time and pins the
# result into NEXT_PUBLIC_SITE_URL for the browser. Nothing needs setting in the
# Vercel dashboard for previews or production to get the right URL.
#
# Set this only to override, e.g. once a custom domain is live.
# NEXT_PUBLIC_SITE_URL=https://sarva.tech


# ---------------------------------------------------------------------------
# Build metadata — set automatically, never by hand
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_BUILD_TIME   stamped by next.config.ts at build time.
# VERCEL_GIT_COMMIT_SHA    commit, reported by GET /api/health.
# VERCEL_GIT_COMMIT_REF    branch, reported by GET /api/health.
# VERCEL_ENV               production | preview | development.
# VERCEL_REGION            serving region.
#
# All are optional. /api/health reports null for any that is absent rather than
# inventing a value.


# ---------------------------------------------------------------------------
# Supabase — submissions storage
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL     the project URL, e.g. https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY  the anon/publishable key
# SUPABASE_SERVICE_ROLE_KEY    SERVER ONLY. Never prefix this NEXT_PUBLIC_.
#
# The submissions table has RLS enabled with NO policies, so the anon key is
# denied both read and write. Every insert goes through /api/intake using the
# service role, which bypasses RLS. That is the whole security model, and it is
# why the service key must never reach a client bundle — lib/supabase-server.ts
# imports 'server-only' so the build fails if it ever does.
#
# Fallback behaviour: with URL or service key unset or empty, /api/health reports
# supabase: not_configured and the overall status derives to "degraded", and
# /api/intake returns 503 with an honest message rather than pretending to have
# saved a lead. Do not set these to silence the readout.
#
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only to apply committed migrations with psql.
# Not read by the application at runtime.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres


# ---------------------------------------------------------------------------
# Resend — submission notifications
# ---------------------------------------------------------------------------
# RESEND_API_KEY          server only.
# SUBMISSION_NOTIFY_TO    where notifications are sent.
# RESEND_FROM             optional. Defaults to Resend's test address,
#                         "Sarva Tech <onboarding@resend.dev>", because the
#                         domain is not verified yet. Real domain verification
#                         is on the pre-launch checklist (CLAUDE.md 13).
#
# Fallback behaviour: with RESEND_API_KEY or SUBMISSION_NOTIFY_TO unset, a
# submission still succeeds. The row is written first and marked notified=false
# with the reason in notify_error. A lead is never lost to a mail problem
# (CLAUDE.md 9).
#
# RESEND_API_KEY=
# SUBMISSION_NOTIFY_TO=
# RESEND_FROM=
