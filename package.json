{
  "name": "sarva-tech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "prebuild": "pnpm run tokens",
    "predev": "pnpm run tokens",
    "dev": "next dev",
    "build": "pnpm run lint && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run tokens && pnpm run contrast && pnpm run typecheck && pnpm run lint && pnpm run verify:env",
    "contrast": "node scripts/contrast.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:bundles": "node scripts/bundle-sizes.mjs",
    "verify:env": "node --experimental-strip-types --no-warnings scripts/verify-clean-env.mjs"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
